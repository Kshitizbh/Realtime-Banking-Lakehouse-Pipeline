# Copy to .env (git-ignored) and change the passwords:  cp .env.example .env
# Every script and container reads its config from here - nothing is hard-coded.

# ---------- Image versions (checked 2026-11-20) ----------
# SeaweedFS 4.48 was released 2026-09-28. Iceberg REST fixture 1.10.0 is a
# confirmed tag; if `docker pull apache/iceberg-rest-fixture:1.12.0` works,
# bump it to match Iceberg 1.12.0 (the REST protocol is compatible either way).
SEAWEEDFS_TAG=4.48
ICEBERG_REST_TAG=1.10.0
POSTGRES_TAG=18-alpine

# ---------- Object storage (SeaweedFS, S3 API) ----------
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-please
S3_REGION=us-east-1
# Scripts you run from Ubuntu use localhost; containers use http://seaweedfs:8333
S3_ENDPOINT_URL=http://localhost:8333
BUCKET_LANDING=landing
BUCKET_WAREHOUSE=warehouse
BUCKET_CHECKPOINTS=checkpoints

# ---------- Iceberg REST catalog ----------
ICEBERG_REST_URI=http://localhost:8181

# ---------- Core-banking Postgres ----------
POSTGRES_HOST=localhost
POSTGRES_DB=core_banking
POSTGRES_USER=core_banking
POSTGRES_PASSWORD=change-me-too

# ---------- Host ports (change if something on Windows already uses them) ----------
S3_HOST_PORT=8333
SEAWEEDFS_UI_PORT=23646
ICEBERG_REST_HOST_PORT=8181
POSTGRES_HOST_PORT=5432

# ---------- Local paths / app ----------
LOCAL_DATA_DIR=./data
LOG_LEVEL=INFO
